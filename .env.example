# Copy to .env and fill in. Never commit .env.
# Create a key at https://dash.molochai.dev/account?utm_source=github&utm_medium=oss&utm_campaign=uncensored-ai-node
# The SDK reads process.env; it does not load .env files itself. Node can: node --env-file=.env app.mjs
MOLOCHAI_API_KEY=your-api-key

# Optional. Default: https://api.molochai.dev/api/v1
# For the local mock server: http://127.0.0.1:4010/api/v1 with MOLOCHAI_API_KEY=mock-key
# MOLOCHAI_BASE_URL=

# Optional. Seconds to wait for a response, and between stream chunks. Default: 120
# MOLOCHAI_TIMEOUT=

# Optional. Retries after the first attempt. Default: 2
# MOLOCHAI_MAX_RETRIES=
